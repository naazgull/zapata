{
    "module": "auth/oauth2_device_code",
    "openapi": "3.0.3",
    "description": "OAuth2 Device Code grant (RFC 8628).",
    "info": {
        "title": "OAuth2 Device Code API",
        "description":
            "Device Authorization Grant (RFC 8628). The client calls exactly two endpoints: /oauth2/authorize_device to obtain a device_code and user_code, and /oauth2/token (grant_type=device_code) to poll for the token. Approving the authorization is a resource-owner action performed by the human at the returned verification_uri; it is not a client API call.",
        "namespace": "zpt",
        "dbDriver": "mysqlx",
        "version": "1.0"
    },
    "servers": [
        {
            "url": "/1.0",
            "description": "Base path for the versioned API.",
            "variables": {
                "base_path": {
                    "default": "1.0",
                    "description": "API version path segment (e.g. 1.0)."
                }
            }
        }
    ],
    "paths": {
        "/oauth2/authorize_device": {
            "description":
                "Device authorization endpoint (RFC 8628). Handled by zpt::auth::oauth2::authorize_device. Issues a device_code and a user_code for offline approval.",
            "resource": "controller",
            "zpt:extends": {
                "super": "zpt::auth::oauth2::authorize_device",
                "no-override": [
                    "blocked",
                    "authorized"
                ]
            },
            "post": {
                "operationId": "oauth2_authorize_device",
                "description":
                    "Request a device authorization. Requires client_id; scope is optional. Returns the device_code, user_code, verification_uri, expiry and polling interval.",
                "requestBody": {
                    "description": "Device authorization request.",
                    "$ref": "#/components/schemas/oauth2_authorize_device_request"
                },
                "responses": {
                    "200": {
                        "description": "Device authorization issued.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/oauth2_authorize_device"
                                }
                            }
                        }
                    },
                    "412": {
                        "description": "Missing required parameter (client_id)."
                    }
                }
            }
        },
        "/oauth2/token": {
            "description":
                "Token endpoint for grant_type=device_code (RFC 8628). Handled by zpt::auth::oauth2::token. The client polls this endpoint with the device_code until the resource owner has approved the authorization at the verification_uri.",
            "resource": "controller",
            "zpt:extends": {
                "super": "zpt::auth::oauth2::token",
                "no-override": [
                    "blocked",
                    "authorized"
                ]
            },
            "post": {
                "operationId": "oauth2_token_device_code",
                "description":
                    "Poll for a device grant token. Requires grant_type=device_code and device_code. Returns the token once the resource owner has approved at the verification_uri; otherwise an RFC 8628 error (authorization_pending, access_denied, expired_token or invalid_grant).",
                "requestBody": {
                    "description": "Device code token request.",
                    "$ref": "#/components/schemas/oauth2_device_code_request"
                },
                "responses": {
                    "200": {
                        "description": "The authorization was approved; the token is returned.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/oauth2_token"
                                }
                            }
                        }
                    },
                    "400": {
                        "description":
                            "Device flow error: authorization_pending, access_denied, expired_token or invalid_grant.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/oauth2_error"
                                }
                            }
                        }
                    },
                    "412": {
                        "description": "Missing required parameter (device_code)."
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "oauth2_authorize_device_request": {
                "description": "Request body for initiating a device authorization.",
                "allOf": [
                    {
                        "type": "object",
                        "properties": {
                            "client_id": {
                                "type": "string",
                                "description": "The OAuth2 client identifier."
                            },
                            "scope": {
                                "type": "string",
                                "description": "Comma-separated list of requested scopes."
                            }
                        },
                        "required": [
                            "client_id"
                        ]
                    }
                ]
            },
            "oauth2_authorize_device": {
                "description": "Device authorization response (RFC 8628).",
                "type": "object",
                "properties": {
                    "device_code": {
                        "type": "string",
                        "description":
                            "High-entropy secret the client polls the token endpoint with. Kept by the client, never shown to or typed by the user."
                    },
                    "user_code": {
                        "type": "string",
                        "description":
                            "Short, human-readable code shown to the user, who enters it at the verification_uri to approve the authorization. Not sent by the client to the token endpoint."
                    },
                    "verification_uri": {
                        "type": "string",
                        "format": "uri",
                        "description":
                            "URI the resource owner visits to enter the user_code and approve the device."
                    },
                    "expires_in": {
                        "type": "integer",
                        "description": "Lifetime of the codes in seconds."
                    },
                    "interval": {
                        "type": "integer",
                        "description": "Minimum polling interval in seconds. Fixed at 5."
                    }
                },
                "required": [
                    "device_code",
                    "user_code",
                    "verification_uri",
                    "expires_in",
                    "interval"
                ]
            },
            "oauth2_device_code_request": {
                "description": "Request body for polling the device grant token.",
                "allOf": [
                    {
                        "type": "object",
                        "properties": {
                            "grant_type": {
                                "type": "string",
                                "enum": [
                                    "device_code"
                                ],
                                "description": "Grant type. Must be \"device_code\"."
                            },
                            "device_code": {
                                "type": "string",
                                "description":
                                    "The device_code returned by the device authorization endpoint."
                            }
                        },
                        "required": [
                            "grant_type",
                            "device_code"
                        ]
                    }
                ]
            },
            "oauth2_token": {
                "description": "An OAuth2 token document issued by the authorization server.",
                "type": "object",
                "properties": {
                    "access_token": {
                        "type": "string",
                        "description": "The issued access token."
                    },
                    "refresh_token": {
                        "type": "string",
                        "description": "The issued refresh token."
                    },
                    "expires": {
                        "type": "date",
                        "description": "Unix epoch timestamp after which the token is invalid."
                    },
                    "scope": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Granted OAuth2 scopes."
                    },
                    "client_id": {
                        "type": "string",
                        "description": "The client the token was issued to."
                    },
                    "owner_id": {
                        "type": "string",
                        "description": "The resource owner the token belongs to."
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Roles associated with the token."
                    },
                    "permissions": {
                        "type": "string",
                        "description": "Permissions granted to the token."
                    }
                },
                "required": [
                    "access_token",
                    "expires",
                    "client_id"
                ]
            },
            "oauth2_error": {
                "description": "OAuth2 error response.",
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string",
                        "description":
                            "Machine-readable error identifier. For the device flow: authorization_pending, access_denied, expired_token or invalid_grant."
                    },
                    "error_description": {
                        "type": "string",
                        "description": "Human-readable description of the error."
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        "parameters": {},
        "headers": {},
        "securitySchemes": {}
    },
    "security": [],
    "tags": [
        {
            "name": "oauth2",
            "description": "OAuth2 flows."
        },
        {
            "name": "device_code",
            "description": "Device Authorization Grant (RFC 8628)."
        }
    ]
}

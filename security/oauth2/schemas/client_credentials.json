{
    "module": "auth/oauth2_client_credentials",
    "openapi": "3.0.3",
    "description": "OAuth2 Client Credentials grant.",
    "info": {
        "title": "OAuth2 Client Credentials API",
        "description":
          "Client Credentials flow: a confidential client authenticates to /oauth2/authorize with response_type=client_credentials using its own client_id and client_secret to obtain an access token acting as itself.",
        "namespace": "zpt",
        "dbDriver": "mysqlx",
        "version": "1.0"
    },
    "servers": [
        {
            "url": "/1.0",
            "description": "Base path for the versioned API.",
            "variables": {
                "base_path": {
                    "default": "1.0",
                    "description": "API version path segment (e.g. 1.0)."
                }
            }
        }
    ],
    "paths": {
        "/oauth2/authorize": {
            "description":
              "Authorization endpoint for response_type=client_credentials. Handled by zpt::auth::oauth2::authorize. Authenticates the client with its credentials and issues a token.",
            "resource": "controller",
            "zpt:extends": {
                "super": "zpt::auth::oauth2::authorize",
                "no-override": ["blocked", "authorized"]
            },
            "post": {
                "operationId": "oauth2_authorize_client_credentials",
                "description":
                  "Client Credentials grant (response_type=client_credentials). Requires client_id and client_secret. If redirect_uri is supplied the token is returned via a redirect, otherwise in the JSON body (without roles/permissions).",
                "requestBody": {
                    "description": "Client credentials grant request.",
                    "$ref": "#/components/schemas/oauth2_client_credentials_request"
                },
                "responses": {
                    "200": {
                        "description": "Token issued (returned when no redirect_uri is supplied).",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/oauth2_token" }
                            }
                        }
                    },
                    "303": {
                        "description":
                          "See Other redirect (POST variant) to redirect_uri with access_token, refresh_token, expires and state, or an error when the client is not found.",
                        "headers": {
                            "Location": {
                                "description": "Target URI for the redirect.",
                                "schema": { "type": "string" }
                            }
                        }
                    },
                    "307": {
                        "description":
                          "Temporary redirect (GET variant) to redirect_uri with the token query string, or an error.",
                        "headers": {
                            "Location": {
                                "description": "Target URI for the redirect.",
                                "schema": { "type": "string" }
                            }
                        }
                    },
                    "400": {
                        "description": "Unknown response_type, or the client could not be resolved when no redirect_uri is supplied.",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/oauth2_error" }
                            }
                        }
                    },
                    "412": {
                        "description": "Missing required parameter (client_id or client_secret)."
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "oauth2_client_credentials_request": {
                "description": "Request body for the Client Credentials grant.",
                "allOf": [
                    {
                        "type": "object",
                        "properties": {
                            "response_type": {
                                "type": "string",
                                "enum": ["client_credentials"],
                                "description": "Response type. Must be \"client_credentials\"."
                            },
                            "client_id": {
                                "type": "string",
                                "description": "The OAuth2 client identifier."
                            },
                            "client_secret": {
                                "type": "string",
                                "description": "The OAuth2 client secret."
                            },
                            "scope": {
                                "type": "string",
                                "description": "Comma-separated list of requested scopes."
                            },
                            "redirect_uri": {
                                "type": "string",
                                "format": "uri",
                                "description":
                                  "If present, the token is returned via a redirect instead of the body."
                            },
                            "state": {
                                "type": "string",
                                "description": "Opaque value echoed back in the redirect."
                            }
                        },
                        "required": ["response_type", "client_id", "client_secret"]
                    }
                ]
            },
            "oauth2_token": {
                "description": "An OAuth2 token document issued by the authorization server.",
                "type": "object",
                "properties": {
                    "access_token": {
                        "type": "string",
                        "description": "The issued access token."
                    },
                    "refresh_token": {
                        "type": "string",
                        "description": "The issued refresh token."
                    },
                    "expires": {
                        "type": "date",
                        "description":
                          "Unix epoch timestamp after which the token is invalid."
                    },
                    "scope": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Granted OAuth2 scopes."
                    },
                    "client_id": {
                        "type": "string",
                        "description": "The client the token was issued to."
                    },
                    "owner_id": {
                        "type": "string",
                        "description":
                          "The resource owner the token belongs to. Empty/null for client_credentials."
                    },
                    "roles": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Roles associated with the token. Omitted in non-redirect responses."
                    },
                    "permissions": {
                        "type": "string",
                        "description":
                          "Permissions granted to the token. Omitted in non-redirect responses."
                    }
                },
                "required": ["access_token", "expires", "client_id"]
            },
            "oauth2_error": {
                "description": "OAuth2 error response.",
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string",
                        "description": "Machine-readable error identifier."
                    },
                    "error_description": {
                        "type": "string",
                        "description": "Human-readable description of the error."
                    }
                },
                "required": ["error"]
            }
        },
        "parameters": {},
        "headers": {},
        "securitySchemes": {}
    },
    "security": [],
    "tags": [
        { "name": "oauth2", "description": "OAuth2 flows." },
        { "name": "client_credentials", "description": "Client Credentials grant." }
    ]
}
